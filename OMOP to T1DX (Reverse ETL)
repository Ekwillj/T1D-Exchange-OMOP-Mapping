CREATE OR ALTER VIEW dbo.v_payer_plan_tier AS
SELECT
    r.person_id,
    r.tier,
    r.payer_plan_period_start_date,
    r.payer_plan_period_end_date,
    CASE r.payer_concept_id
        WHEN 436 THEN '1'     -- Self-pay
        WHEN 327 THEN '2'     -- Private Insurance
        WHEN 289 THEN '3'     -- Medicaid
        WHEN 296 THEN '4'     -- DoD TRICARE (CHAMPUS)
        WHEN 280 THEN '5'     -- Medicare
        ELSE CASE WHEN r.payer_source_value IN ('9', '10')
                  THEN r.payer_source_value   -- 'Other' / 'Unknown' have no concept
                  ELSE '10'
             END
    END AS insurance_type
FROM (
    SELECT t.*,
           ROW_NUMBER() OVER (PARTITION BY t.person_id, t.tier
                              ORDER BY t.payer_plan_period_start_date DESC,
                                       t.payer_plan_period_id) AS rn
    FROM (
        SELECT pp.person_id,
               pp.payer_plan_period_id,
               pp.payer_plan_period_start_date,
               pp.payer_plan_period_end_date,
               pp.payer_concept_id,
               pp.payer_source_value,
               CASE WHEN pp.plan_source_value IN ('primary', 'secondary', 'tertiary')
                    THEN pp.plan_source_value
                    ELSE CASE ROW_NUMBER() OVER (PARTITION BY pp.person_id
                                                 ORDER BY pp.payer_plan_period_start_date,
                                                          pp.payer_plan_period_id)
                             WHEN 1 THEN 'primary'
                             WHEN 2 THEN 'secondary'
                             WHEN 3 THEN 'tertiary'
                         END
               END AS tier
        FROM dbo.payer_plan_period pp
    ) t
    WHERE t.tier IS NOT NULL
) r
WHERE r.rn = 1;
