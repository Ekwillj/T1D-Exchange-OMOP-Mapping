--INSERTING INTO THE PERSON TABLE
INSERT INTO dbo.person (
    person_id,
    care_site_id,
    provider_id,
    gender_concept_id,
    year_of_birth,
    month_of_birth,
    day_of_birth,
    race_concept_id,
    ethnicity_concept_id,
    location_id
)
SELECT
    pid.omop_person_id,
    org.omop_care_site_id,
    prov.omop_provider_id,
    CASE pat.sex
        WHEN 'male' THEN 8507
        WHEN 'female' THEN 8532
        WHEN 'other' THEN 8521
        WHEN 'unknown' THEN 0
        ELSE 0
    END,
    YEAR (pat.birth_date)
    MONTH (pat.birth_date),
    DAY (pat.birth_date),
    
    --ELSE 1900
    -- END,
    -- COALESCE(YEAR(pat.birth_date), 1900),
    -- COALESCE(MONTH(pat.birth_date), 1),
    -- COALESCE(DAY(pat.birth_date), 1),
    CASE pat.race_1
        WHEN pat.race_1 IS NOT NULL THEN
        AND pat.race_2 IS NOT NULL
        AND pat.race_1 <> pat.race_2
            THEN 1546847
        WHEN '1002-5' THEN 8657
        WHEN '2028-9' THEN 8515
        WHEN '2054-5' THEN 8516
        WHEN '2076-8' THEN 8557
        WHEN '2106-3' THEN 8527
        ELSE 0
    END,
    CASE pat.ethnicity
        WHEN '2135-2' THEN 38003563
        WHEN '2186-5' THEN 38003564
        ELSE 0
    END,
    loc.location_id
FROM dbo.T1DX_patients pat
JOIN dbo.patient_id_map pid ON pid.t1d_patient_id = pat.patient_id
JOIN dbo.organization_map org ON org.t1d_organization_id = pat.organization_id
JOIN dbo.provider_map prov ON prov.t1d_provider_id = pat.provider_id
LEFT JOIN dbo.location loc ON loc.zip = pat.postal_code
WHERE pat.birth_date IS NOT NULL;

