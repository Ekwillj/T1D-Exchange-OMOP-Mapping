INSERT INTO dbo.visit_occurrence (
visit_occurrence_id,
person_id,
visit_concept_id,
visit_start_date,
visit_end_date,
visit_end_datetime,
visit_type_concept_id,
provider_id,
care_site_id,
visit_source_value,
visit_source_concept_id

)
SELECT
t1dx.encounter_id,
pmap.omop_person_id,
    CASE t1dx.class
        WHEN 'inpatient' THEN 9201
        WHEN 'outpatient' THEN 9202
        WHEN 'ambulatory' THEN 9202
        WHEN 'emergency' THEN 9203
        WHEN 'home' THEN 581476
        WHEN 'field' THEN 42898160
        WHEN 'daytime' THEN 9202
        WHEN 'virtual' THEN 722455
        WHEN 'education' THEN 9202 --this is defined as an encounter during which the patient receives education. because the encounter represents a healthcare interaction rather than an inpatient, emergency, or home-care setting.
        WHEN 'other' THEN 0
        WHEN 'medication' THEN 38004338
        WHEN 'laboratory' THEN 32036
    ELSE 0
END,
t1dx.encounter_date,
t1dx.encounter_date, --The source specification provides only an encounter start date. OMOP requires visit_start_date and visit_end_date. The ETL derives visit_end_date as equal to visit_start_date for all visits.
t1dx.encounter_time,
'32817', -- this identifies that the encounter was derived from an EHR system. 
prov.omop_provider_id,
org.omop_care_site_id,
t1dx.class,
0,
END
FROM dbo.T1DX_encounters t1dx
JOIN dbo.encounter_map emap ON emap.t1d_encounter_id = t1dx.encounter_id
JOIN dbo.patient_id_map pmap ON pmap.t1d_patient_id = t1dx.patient_id
