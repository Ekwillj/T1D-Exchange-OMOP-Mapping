--Mapping Conditions table
INSERT INTO dbo.condition_occurrence (
    condition_occurrence_id,
    person_id,
    condition_concept_id,
    condition_start_date,
    condition_end_date,
    condition_type_concept_id,
    stop_reason,
    provider_id,
    visit_occurrence_id,
    condition_source_value,
    condition_source_concept_id
)

SELECT 
    cmap.omop_condition_id,
    pmap.omop_person_id,
    0, --there are no conditions clarified in the condition table for the T1DX data spec. Could map to 201254, type 1 diabetes mellitus, but other conditions are not specified. This is a placeholder for future mapping.
    t1dx.onset_date,  
    t1dx.abatement_date,
    32817, -- this identifies that the condition was derived from an EHR system.
    NULL AS stop_reason,
    prov.omop_provider_id,
    emap.omop_visit_id,
    t1dx.code AS condition_source_value,
    IS NULL(src.concept_id, 0) AS condition_source_concept_id
FROM dbo.T1DX_conditions t1dx
JOIN dbo.condition_map cmap ON cmap.t1d_condition_id = t1dx.condition_id
JOIN dbo.patient_id_map   pmap ON pmap.t1d_patient_id  = t1dx.patient_id
LEFT JOIN dbo.provider_map  prov ON prov.t1d_provider_id = t1dx.provider_id
LEFT JOIN dbo.encounter_map emap ON emap.t1d_encounter_id = t1dx.encounter_id
CROSS APPLY (
    SELECT CASE t1dx.code_type
        WHEN 'snomedct' THEN 'SNOMED'
        WHEN 'icd10' THEN 'ICD10CM'
        WHEN 'icd9' THEN 'ICD9CM'
        WHEN 'icd11' THEN 'ICD11'
    END AS vocabulary_id
) v
LEFT JOIN dbo.concept src
       ON src.concept_code   = t1dx.code
      AND src.vocabulary_id  = v.vocabulary_id
LEFT JOIN dbo.concept_relationship cr
       ON cr.concept_id_1    = src.concept_id
      AND cr.relationship_id = 'Maps to'
      AND cr.invalid_reason IS NULL
LEFT JOIN dbo.concept c
       ON c.concept_id     = cr.concept_id_2
      AND c.invalid_reason IS NULL;

-- Provenance: source rows come from written prescriptions (written_date, prescriber_id).
-- 32838 = 'EHR prescription' (Type Concept domain; confirmed in Athena).
DECLARE @drug_type_concept_id INT = 32838;
 
 --mapping to drug_exposure table
INSERT INTO dbo.drug_exposure (
      drug_exposure_id,
      person_id,
      drug_concept_id,
      drug_exposure_start_date,
      drug_exposure_end_date,
      drug_type_concept_id,
      stop_reason,
      provider_id,
      visit_occurrence_id,
      quantity,
      days_supply,
      sig,
      route_concept_id,
      lot_number,
      drug_source_value,
      drug_source_concept_id
)
SELECT
    mmap.omop_drug_exposure_id,
    pmap.omop_person_id,
 
    -- Standard concept: source concept -> 'Maps to' -> standard Drug concept
    COALESCE(std.concept_id, 0)                         AS drug_concept_id,
 
    t1dx.written_date                                   AS drug_exposure_start_date,
    t1dx.written_date                                   AS drug_exposure_end_date,   -- required (NOT NULL); end unknown
    @drug_type_concept_id                               AS drug_type_concept_id,
    NULL                                                AS stop_reason,
    prov.omop_provider_id,
    emap.omop_visit_id,
    NULL                                                AS quantity,
    NULL                                                AS days_supply,
    NULL                                                AS sig,
    NULL                                                AS route_concept_id,
    NULL                                                AS lot_number,
    t1dx.code                                           AS drug_source_value,
 
    -- Source concept: the RxNorm / NDC / SNOMED concept as-is; 0 if internal or not found
    COALESCE(src.concept_id, 0)                         AS drug_source_concept_id
 
FROM dbo.T1DX_medications t1dx
JOIN dbo.medication_map mmap
    ON mmap.t1d_medication_id = t1dx.medication_id
JOIN dbo.patient_id_map pmap
    ON pmap.t1d_patient_id = t1dx.patient_id
LEFT JOIN dbo.provider_map prov
    ON prov.t1d_provider_id = t1dx.prescriber_id
LEFT JOIN dbo.encounter_map emap
    ON emap.t1d_encounter_id = t1dx.encounter_id
 
-- Source concept lookup (internal / unknown code types return no row -> 0)
OUTER APPLY (
    SELECT TOP (1) c.concept_id
    FROM dbo.concept c
    WHERE c.vocabulary_id = CASE LOWER(t1dx.code_type)
                                WHEN 'rxnorm'   THEN 'RxNorm'
                                WHEN 'ndc'      THEN 'NDC'
                                WHEN 'snomedct' THEN 'SNOMED'
                            END
      AND c.concept_code = t1dx.code
    ORDER BY c.concept_id
) src
 
-- Standard concept lookup (RxNorm maps to itself when standard)
OUTER APPLY (
    SELECT TOP (1) tgt.concept_id
    FROM dbo.concept_relationship cr
    JOIN dbo.concept tgt
        ON tgt.concept_id = cr.concept_id_2
    WHERE cr.concept_id_1     = src.concept_id
      AND cr.relationship_id  = 'Maps to'
      AND cr.invalid_reason IS NULL
      AND tgt.standard_concept = 'S'
      AND tgt.domain_id        = 'Drug'
    ORDER BY tgt.concept_id
) std
 
WHERE t1dx.written_date IS NOT NULL;   -- start date is NOT NULL in drug_exposure
 
 

--T1DX medication status -> dbo.observation

DECLARE @med_status_obs_concept_id  INT = 1092304;  -- LOINC 106199-3 Status (Observation, standard)
DECLARE @obs_event_field_concept_id INT = 1147707;  -- drug_exposure.drug_exposure_id (Metadata domain; confirmed)
DECLARE @obs_type_concept_id        INT = 32817;
DECLARE @max_obs_id BIGINT = (SELECT COALESCE(MAX(observation_id), 0) FROM dbo.observation);
 
INSERT INTO dbo.observation (
      observation_id,
      person_id,
      observation_concept_id,
      observation_date,
      observation_type_concept_id,
      value_as_number,
      value_as_string,
      value_as_concept_id,
      qualifier_concept_id,
      unit_concept_id,
      provider_id,
      visit_occurrence_id,
      observation_source_value,
      observation_source_concept_id,
      value_source_value,
      observation_event_id,
      obs_event_field_concept_id
)
SELECT
    @max_obs_id + ROW_NUMBER() OVER (ORDER BY mmap.omop_drug_exposure_id),
    pmap.omop_person_id,
    @med_status_obs_concept_id,
    t1dx.written_date,
    @obs_type_concept_id,
    NULL,
    LOWER(t1dx.status),                              -- raw status preserved
    CASE LOWER(t1dx.status)
        WHEN 'active'   THEN 9181   -- SNOMED 55561003 Active
        WHEN 'inactive' THEN 9173   -- SNOMED 73425007 Inactive
        ELSE 0                                       -- 'other' / unknown
    END,
    NULL, NULL,
    prov.omop_provider_id,
    emap.omop_visit_id,
    'T1DX_medications.status',
    0,
    t1dx.status,
    mmap.omop_drug_exposure_id,
    @obs_event_field_concept_id
FROM dbo.T1DX_medications t1dx
JOIN dbo.medication_map mmap
    ON mmap.t1d_medication_id = t1dx.medication_id
JOIN dbo.patient_id_map pmap
    ON pmap.t1d_patient_id = t1dx.patient_id
LEFT JOIN dbo.provider_map prov
    ON prov.t1d_provider_id = t1dx.prescriber_id
LEFT JOIN dbo.encounter_map emap
    ON emap.t1d_encounter_id = t1dx.encounter_id
WHERE t1dx.written_date IS NOT NULL
  AND t1dx.status IS NOT NULL;

