DECLARE @max_ppp BIGINT = (SELECT COALESCE(MAX(payer_plan_period_id), 0) FROM dbo.payer_plan_period);

--mapping to the payer_plan_period table
INSERT INTO dbo.payer_plan_period (
      payer_plan_period_id,
      person_id,
      payer_plan_period_start_date,
      payer_plan_period_end_date,
      payer_concept_id,
      payer_source_value,
      payer_source_concept_id,
      plan_concept_id,
      plan_source_value,
      plan_source_concept_id,
      sponsor_concept_id,
      sponsor_source_value,
      sponsor_source_concept_id,
      family_source_value,
      stop_reason_concept_id,
      stop_reason_source_value,
      stop_reason_source_concept_id
)
SELECT
    @max_ppp + ROW_NUMBER() OVER (ORDER BY pm.omop_person_id, ins.tier_order),
    pm.omop_person_id,
    enc.first_date,
    enc.last_date,
    CASE ins.insurance_type            -- SOPT payer concepts (Payer domain)
        WHEN '1'  THEN 436             -- None, self pay: Self-pay
        WHEN '2'  THEN 327             -- Private: Private Insurance
        WHEN '3'  THEN 289             -- Medicaid
        WHEN '4'  THEN 296             -- Military: SOPT 311 DoD TRICARE (CHAMPUS)
        WHEN '5'  THEN 280             -- Medicare
        WHEN '9'  THEN 0               -- Other 
        WHEN '10' THEN 0               -- Unknown
        ELSE 0
    END,
    ins.insurance_type,
    0,
    0,
    ins.tier,
    0,
    0,
    NULL,
    0,
    NULL,
    0,
    NULL,
    0
FROM dbo.T1DX_patients pat
JOIN dbo.patient_id_map pm
    ON pm.t1d_patient_id = pat.patient_id
JOIN dbo.person p
    ON p.person_id = pm.omop_person_id
JOIN (
    SELECT e.patient_id,
           MIN(e.encounter_date) AS first_date,
           MAX(e.encounter_date) AS last_date
    FROM dbo.T1DX_encounters e
    WHERE e.encounter_date IS NOT NULL
    GROUP BY e.patient_id
) enc
    ON enc.patient_id = pat.patient_id
CROSS APPLY (VALUES
    (1, 'primary',   pat.primary_insurance_type),
    (2, 'secondary', pat.secondary_insurance_type),
    (3, 'tertiary',  pat.tertiary_insurance_type)
) ins (tier_order, tier, insurance_type)
WHERE ins.insurance_type IS NOT NULL;
