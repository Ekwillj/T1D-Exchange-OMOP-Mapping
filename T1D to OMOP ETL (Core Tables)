INSERT INTO dbo.observation (
    observation_id,
    person_id,
    observation_concept_id,
    observation_date,
    observation_datetime,
    observation_type_concept_id,
    value_as_number,
    value_as_string,
    value_as_concept_id,
    unit_concept_id,
    visit_occurrence_id,
    observation_source_value,
    observation_source_concept_id
)
SELECT 
    omap.omop_observation_id,
    pmap.omop_person_id,
    -- Map LOINC or internal code to OMOP concept_id
    CASE
   WHEN t1dx.code = '54845-3' THEN 40757976
   WHEN t1dx.code = '11367-0' THEN 3012697
   WHEN t1dx.code = '74011-8' THEN 44786669
   WHEN t1dx.code = '97063-2' THEN 1616473
   WHEN t1dx.code = '55758-7' THEN 40758879
   WHEN t1dx.code = '70272-0' THEN 42868744
   WHEN t1dx.code = '94328-2' THEN 36660083
   WHEN t1dx.code = '44261-6' THEN 3042932
   WHEN t1dx.code = '70274-6' THEN 42868746
   WHEN t1dx.code = '88124-3' THEN 36304002
   WHEN t1dx.code = '88122-7' THEN 36304041
   WHEN t1dx.code = '93030-5' THEN 37020730
   WHEN t1dx.code = '93033-9' THEN 37020172
    END,
    t1dx.effective_date,
    t1dx.effective_time,
--mapping category to OMOP observation_type_concept_id
    CASE t1dx.category
        WHEN 'social-history' THEN 4059767
        WHEN 'survey' THEN 32883
        ELSE 0
   END,
   CASE WHEN ISNUMERIC(t1dx.value) = 1 THEN CAST(t1dx.value AS FLOAT) ELSE NULL END,
   CASE WHEN ISNUMERIC(t1dx.value) = 0 THEN t1dx.value ELSE NULL END,
   CASE t1dx.value
       WHEN 'yes' THEN 4188539
       WHEN 'no' THEN 4188540
       ELSE 0
    END,
    --mappig value unites to unit_concept_id
   CASE t1dx.value_units
       WHEN 'mg/dL' THEN 8840
       WHEN 'mmol/L' THEN 8753
       WHEN '[iU]/mL' THEN 8985
       WHEN '%' THEN 8554
       WHEN 'cm' THEN 8582
       WHEN 'kg' THEN 9529
       WHEN 'm' THEN 9546
       WHEN '°C' THEN 586323
       WHEN 'mm[Hg]' THEN 8876
       WHEN '/min' THEN 8541
       ELSE 0
    END,
    emap.omop_visit_id,
    t1dx.code,
    CASE t1dx.code_type
        WHEN 'LOINC' THEN 37079395
        WHEN 't2d' THEN 0
        ELSE 0
    END
FROM dbo.T1DX_observations t1dx
JOIN dbo.observation_map omap ON omap.t1d_observation_id = t1dx.observation_id
JOIN dbo.patient_id_map pmap ON pmap.t1d_patient_id = t1dx.patient_id
LEFT JOIN dbo.encounter_map emap ON emap.t1d_encounter_id = t1dx.encounter_id;


